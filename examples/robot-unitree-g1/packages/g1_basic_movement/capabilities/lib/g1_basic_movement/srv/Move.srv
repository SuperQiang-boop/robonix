# Velocity-based movement command.
# Positive vx = forward, positive vy = left, positive wz = turn left.
float32 vx          # forward velocity (m/s), clamped to [-1.0, 1.0]
float32 vy          # lateral velocity (m/s), clamped to [-0.5, 0.5]
float32 wz          # angular velocity (rad/s), clamped to [-2.0, 2.0]
float32 duration_s  # how long to move (seconds), clamped to [0.1, 10.0]
---
bool accepted
string detail
